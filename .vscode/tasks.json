{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "maven-compile-workbench",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/maven-compile-workbench.ps1",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File"
          ]
        }
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true,
        "close": true,
        "focus": false
      }
    }
  ]
}
