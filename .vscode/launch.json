{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "WorkbenchApplication",
      "request": "launch",
      "mainClass": "com.workbench.app.WorkbenchApplication",
      "projectName": "workbench-app",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "shortenCommandLine": "argfile",
      "vmArgs": "-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8"
    },
    {
      "type": "java",
      "name": "WorkbenchApplication (with maven prebuild)",
      "request": "launch",
      "mainClass": "com.workbench.app.WorkbenchApplication",
      "projectName": "workbench-app",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "shortenCommandLine": "argfile",
      "preLaunchTask": "maven-compile-workbench",
      "vmArgs": "-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8"
    }
  ]
}
