WORKBENCH_APP_NAME=workbench-backend
WORKBENCH_APP_VERSION=0.1.0
WORKBENCH_ENVIRONMENT=development
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=8001

# AES-GCM 主密钥（加密 api_key / app_secret 等 *_ciphertext 列）；生产务必更换
WORKBENCH_SECRET_KEY=workbench-dev-secret-key-change-me!!

# Spring datasource (also in application.yml)
# jdbc:mysql://127.0.0.1:3306/workbench_v2
# user/password: workbench / workbench_dev

# Redis
# 127.0.0.1:6379

# AI upstream timeouts (also in application.yml under workbench.*)
# WORKBENCH_AI_TEXT_TIMEOUT_SECONDS=120
# WORKBENCH_AI_IMAGE_TIMEOUT_SECONDS=180
