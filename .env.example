CHENGWENFANG_APP_NAME=chengwenfang-backend
CHENGWENFANG_APP_VERSION=0.1.0
CHENGWENFANG_ENVIRONMENT=development
CHENGWENFANG_HOST=127.0.0.1
CHENGWENFANG_PORT=8001

# AES-GCM master key for *_ciphertext columns; change in any non-dev environment
CHENGWENFANG_SECRET_KEY=chengwenfang-dev-secret-key-change-me!!

# Spring datasource (also in application.yml)
# jdbc:mysql://127.0.0.1:3306/chengwenfang
# user/password: chengwenfang / chengwenfang_dev

# Redis (default database 0). Beside another instance: SPRING_DATA_REDIS_DATABASE=1
# 127.0.0.1:6379

# Optional dual-instance overrides (see README「与另一实例并存」)
# SERVER_PORT=8002
# SPRING_DATA_REDIS_DATABASE=1
# VITE_DEV_PORT=5174
# VITE_API_PROXY=http://127.0.0.1:8002

# AI upstream timeouts (also in application.yml under chengwenfang.*)
# CHENGWENFANG_AI_TEXT_TIMEOUT_SECONDS=120
# CHENGWENFANG_AI_IMAGE_TIMEOUT_SECONDS=180
